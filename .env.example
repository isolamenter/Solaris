# Solaris Server configuration — CONTRACTS §13.
#
# Every value is a placeholder. Copy to .env.local (loaded once at startup) or
# export the variables in the service manager. A missing required value stops
# the process with a message naming the variable; nothing here has a fallback.

# ---------------------------------------------------------------------------
# Deployment boundary
# ---------------------------------------------------------------------------

# REQUIRED. The origin this Server is reached at. It defines the only `Host`
# value that is served, and (unless SOLARIS_ALLOWED_ORIGINS adds more) the only
# browser `Origin` accepted. Must be https; http is accepted only for a literal
# loopback host, which is how a local development server is reached.
SOLARIS_PUBLIC_ORIGIN=https://solaris.example.com

# Optional. Extra origins allowed to call the API, comma separated, exact
# origins only (no paths). Use it for a deployment whose browser client is served
# from a different origin. Default: SOLARIS_PUBLIC_ORIGIN alone.
# SOLARIS_ALLOWED_ORIGINS=https://app.example.com

# Optional. Number of trusted reverse-proxy hops in front of this process, e.g.
# 1 for a single TLS-terminating proxy or tunnel. It is a hop count and not a
# boolean: `true` would mean "believe X-Forwarded-For from anyone". Default 0
# (no proxy trusted; X-Forwarded-For and X-Forwarded-Proto are ignored).
# SOLARIS_TRUST_PROXY=1

# Optional. Interface to listen on. Default 127.0.0.1, which is correct when a
# proxy or tunnel on the same machine forwards to it.
# SOLARIS_BIND_HOST=127.0.0.1

# Optional. Defaults to 3210.
# PORT=3210

# Optional. Defaults to ./.solaris-data (never reuses legacy ./data). One
# process owns this directory.
# SOLARIS_DATA_DIR=.solaris-data

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# REQUIRED. Base64-encoded 32 bytes. Generate with: openssl rand -base64 32
CREDENTIALS_MASTER_KEY=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# REQUIRED. Closed registry; the only public value is oidc.
SOLARIS_AUTH_ADAPTER=oidc

# REQUIRED when SOLARIS_AUTH_ADAPTER=oidc. The Server's own OIDC client at the
# IdP below. The desktop client holds no secret.
SOLARIS_OIDC_ISSUER=https://idp.example.com
SOLARIS_OIDC_CLIENT_ID=solaris-server
SOLARIS_OIDC_CLIENT_SECRET=
# Optional. `openid` is always required; listed here with the profile claim the
# Server uses for a display name.
SOLARIS_OIDC_SCOPES=openid,profile

# Optional. Session lifetime in seconds. Default 2592000 (30 days).
# SOLARIS_SESSION_TTL_SECONDS=2592000

# Optional. Loopback IP literals the desktop callback may use, comma separated.
# Default 127.0.0.1. A non-loopback entry is refused at startup.
# SOLARIS_DESKTOP_REDIRECT_ALLOWLIST=127.0.0.1,::1

# ---------------------------------------------------------------------------
# Credential source
# ---------------------------------------------------------------------------

# REQUIRED. Closed registry; the only public value is user-key (the key a user
# typed for one of their own connections).
SOLARIS_CREDENTIAL_SOURCE=user-key

# ---------------------------------------------------------------------------
# Upstream call budgets (one model call)
# ---------------------------------------------------------------------------

# Optional. Complete deadline for one upstream call: sending, response reading,
# parsing and decoding. Default 90000 ms.
# SOLARIS_UPSTREAM_TIMEOUT_MS=90000

# Optional. Byte budget for the raw upstream response body, read while streaming.
# Must cover base64 inflation plus JSON structure. Default 33554432 (32 MiB).
# SOLARIS_UPSTREAM_RESPONSE_MAX_BYTES=33554432

# ---------------------------------------------------------------------------
# Delivery and replay budgets
# ---------------------------------------------------------------------------

# Optional. Total decoded image bytes one response may deliver. Default 25165824
# (24 MiB). A generation that exceeds it stays `success` and is delivered as
# unavailable/result-too-large.
# SOLARIS_IMAGE_RESULT_MAX_BYTES=25165824

# Optional. In-process result cache TTL in seconds. Default 600. This is a
# best-effort replay window, not a guarantee: the cache is memory-only and is
# lost on restart.
# SOLARIS_RESULT_CACHE_TTL_SECONDS=600

# Optional. Total bytes the result cache may hold. Default 268435456 (256 MiB).
# SOLARIS_RESULT_CACHE_MAX_BYTES=268435456
